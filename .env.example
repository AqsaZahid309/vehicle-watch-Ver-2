# ── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Required in production: a random value of 32+ characters (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-secret-key
DATABASE_URL=postgresql+asyncpg://vehiclewatch:vehiclewatch@localhost:5432/vehiclewatch
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed in production (the SPA is same-origin, so often unnecessary)
ALLOWED_ORIGINS=
# Set false to disable self-service sign-up (users are then created by an org admin)
ALLOW_PUBLIC_SIGNUP=true
PUBLIC_BASE_URL=http://localhost:8000

# ── Auth ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Background worker ───────────────────────────────────────────────────────
# true = worker runs inside the API process; false = run `python -m app.workers.runner` separately
RUN_WORKER_IN_API=true
ANOMALY_WORKER_INTERVAL_SECONDS=60
TELEMETRY_RETENTION_DAYS=90

# ── LLM summaries (optional — rule-based fallback summaries work without it) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Notifications (optional) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@vehiclewatch.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Observability ───────────────────────────────────────────────────────────
# If set, /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
